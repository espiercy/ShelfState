{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "RequestExactPublicCertificate",
      "Effect": "Allow",
      "Action": [
        "acm:RequestCertificate"
      ],
      "Resource": [
        "*"
      ],
      "Condition": {
        "StringEquals": {
          "aws:RequestTag/Project": "ShelfState",
          "aws:RequestTag/Environment": "dev",
          "aws:RequestTag/ManagedBy": "AWS-CDK",
          "aws:RequestedRegion": "us-east-1",
          "acm:ValidationMethod": "DNS",
          "acm:Export": "DISABLED"
        },
        "ForAllValues:StringEquals": {
          "acm:DomainNames": [
            "dev.shelfstate.codecorax.com"
          ]
        },
        "Null": {
          "acm:DomainNames": "false",
          "acm:CertificateAuthority": "true"
        }
      }
    },
    {
      "Sid": "ManageExactCertificate",
      "Effect": "Allow",
      "Action": [
        "acm:DescribeCertificate",
        "acm:DeleteCertificate",
        "acm:ListTagsForCertificate",
        "acm:AddTagsToCertificate",
        "acm:RemoveTagsFromCertificate",
        "acm:UpdateCertificateOptions"
      ],
      "Resource": [
        "arn:aws:acm:us-east-1:${ACCOUNT_ID}:certificate/${CERTIFICATE_ID}"
      ]
    },
    {
      "Sid": "CertificateValidationOnly",
      "Effect": "Allow",
      "Action": [
        "route53:ChangeResourceRecordSets"
      ],
      "Resource": [
        "arn:aws:route53:::hostedzone/${SELECTED_ZONE_ID}"
      ],
      "Condition": {
        "ForAllValues:StringEquals": {
          "route53:ChangeResourceRecordSetsNormalizedRecordNames": [
            "${VALIDATION_RECORD_NAME}"
          ],
          "route53:ChangeResourceRecordSetsRecordTypes": [
            "CNAME"
          ],
          "route53:ChangeResourceRecordSetsActions": [
            "CREATE",
            "UPSERT"
          ]
        },
        "Null": {
          "route53:ChangeResourceRecordSetsNormalizedRecordNames": "false",
          "route53:ChangeResourceRecordSetsRecordTypes": "false",
          "route53:ChangeResourceRecordSetsActions": "false"
        }
      }
    },
    {
      "Sid": "ReadSelectedZone",
      "Effect": "Allow",
      "Action": [
        "route53:GetHostedZone",
        "route53:ListResourceRecordSets"
      ],
      "Resource": [
        "arn:aws:route53:::hostedzone/${SELECTED_ZONE_ID}"
      ]
    },
    {
      "Sid": "PollDnsChange",
      "Effect": "Allow",
      "Action": [
        "route53:GetChange"
      ],
      "Resource": [
        "arn:aws:route53:::change/*"
      ]
    },
    {
      "Sid": "ReadRegionalTemplateAssets",
      "Effect": "Allow",
      "Action": [
        "s3:GetObject",
        "s3:GetObjectVersion"
      ],
      "Resource": [
        "arn:aws:s3:::cdk-hnb659fds-assets-${ACCOUNT_ID}-us-east-1/*"
      ]
    },
    {
      "Sid": "ResolveBootstrapVersion",
      "Effect": "Allow",
      "Action": [
        "ssm:GetParameters"
      ],
      "Resource": [
        "arn:aws:ssm:us-east-1:${ACCOUNT_ID}:parameter/cdk-bootstrap/hnb659fds/version"
      ]
    }
  ]
}
