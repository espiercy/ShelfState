{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "CreateTaggedDistribution",
      "Effect": "Allow",
      "Action": [
        "cloudfront:CreateDistribution"
      ],
      "Resource": [
        "*"
      ],
      "Condition": {
        "StringEquals": {
          "aws:RequestTag/Project": "ShelfState",
          "aws:RequestTag/Environment": "dev",
          "aws:RequestTag/ManagedBy": "AWS-CDK"
        }
      }
    },
    {
      "Sid": "ManageDevDistribution",
      "Effect": "Allow",
      "Action": [
        "cloudfront:GetDistribution",
        "cloudfront:GetDistributionConfig",
        "cloudfront:UpdateDistribution",
        "cloudfront:DeleteDistribution",
        "cloudfront:ListTagsForResource",
        "cloudfront:TagResource",
        "cloudfront:UntagResource"
      ],
      "Resource": [
        "arn:aws:cloudfront::${ACCOUNT_ID}:distribution/${DISTRIBUTION_ID}"
      ]
    },
    {
      "Sid": "CreateOacAndPoliciesPendingAdjudication",
      "Effect": "Allow",
      "Action": [
        "cloudfront:CreateOriginAccessControl",
        "cloudfront:CreateCachePolicy",
        "cloudfront:CreateOriginRequestPolicy",
        "cloudfront:CreateResponseHeadersPolicy"
      ],
      "Resource": [
        "*"
      ]
    },
    {
      "Sid": "ManageOriginAccessControl",
      "Effect": "Allow",
      "Action": [
        "cloudfront:GetOriginAccessControl",
        "cloudfront:GetOriginAccessControlConfig",
        "cloudfront:UpdateOriginAccessControl",
        "cloudfront:DeleteOriginAccessControl"
      ],
      "Resource": [
        "arn:aws:cloudfront::${ACCOUNT_ID}:origin-access-control/${OAC_ID}"
      ]
    },
    {
      "Sid": "ManageCachePolicy",
      "Effect": "Allow",
      "Action": [
        "cloudfront:GetCachePolicy",
        "cloudfront:GetCachePolicyConfig",
        "cloudfront:UpdateCachePolicy",
        "cloudfront:DeleteCachePolicy"
      ],
      "Resource": [
        "arn:aws:cloudfront::${ACCOUNT_ID}:cache-policy/${CACHE_POLICY_ID}"
      ]
    },
    {
      "Sid": "ManageOriginRequestPolicy",
      "Effect": "Allow",
      "Action": [
        "cloudfront:GetOriginRequestPolicy",
        "cloudfront:GetOriginRequestPolicyConfig",
        "cloudfront:UpdateOriginRequestPolicy",
        "cloudfront:DeleteOriginRequestPolicy"
      ],
      "Resource": [
        "arn:aws:cloudfront::${ACCOUNT_ID}:origin-request-policy/${ORIGIN_REQUEST_POLICY_ID}"
      ]
    },
    {
      "Sid": "ManageResponseHeadersPolicy",
      "Effect": "Allow",
      "Action": [
        "cloudfront:GetResponseHeadersPolicy",
        "cloudfront:GetResponseHeadersPolicyConfig",
        "cloudfront:UpdateResponseHeadersPolicy",
        "cloudfront:DeleteResponseHeadersPolicy"
      ],
      "Resource": [
        "arn:aws:cloudfront::${ACCOUNT_ID}:response-headers-policy/${RESPONSE_HEADERS_POLICY_ID}"
      ]
    },
    {
      "Sid": "DevAliasesOnly",
      "Effect": "Allow",
      "Action": [
        "route53:ChangeResourceRecordSets"
      ],
      "Resource": [
        "arn:aws:route53:::hostedzone/${SELECTED_ZONE_ID}"
      ],
      "Condition": {
        "ForAllValues:StringEquals": {
          "route53:ChangeResourceRecordSetsNormalizedRecordNames": [
            "dev.shelfstate.codecorax.com"
          ],
          "route53:ChangeResourceRecordSetsRecordTypes": [
            "A",
            "AAAA"
          ],
          "route53:ChangeResourceRecordSetsActions": [
            "CREATE",
            "UPSERT",
            "DELETE"
          ]
        },
        "Null": {
          "route53:ChangeResourceRecordSetsNormalizedRecordNames": "false",
          "route53:ChangeResourceRecordSetsRecordTypes": "false",
          "route53:ChangeResourceRecordSetsActions": "false"
        }
      }
    },
    {
      "Sid": "CreateBoundedHealthRole",
      "Effect": "Allow",
      "Action": [
        "iam:CreateRole"
      ],
      "Resource": [
        "arn:aws:iam::${ACCOUNT_ID}:role/shelfstate-v4-dev-health"
      ],
      "Condition": {
        "StringEquals": {
          "iam:PermissionsBoundary": "arn:aws:iam::${ACCOUNT_ID}:policy/ShelfStateV4DevHealthBoundary",
          "aws:RequestTag/Project": "ShelfState",
          "aws:RequestTag/Environment": "dev",
          "aws:RequestTag/ManagedBy": "AWS-CDK"
        }
      }
    },
    {
      "Sid": "ManageHealthRole",
      "Effect": "Allow",
      "Action": [
        "iam:GetRole",
        "iam:DeleteRole",
        "iam:GetRolePolicy",
        "iam:ListRolePolicies",
        "iam:ListAttachedRolePolicies",
        "iam:PutRolePolicy",
        "iam:DeleteRolePolicy",
        "iam:UpdateAssumeRolePolicy",
        "iam:TagRole",
        "iam:UntagRole"
      ],
      "Resource": [
        "arn:aws:iam::${ACCOUNT_ID}:role/shelfstate-v4-dev-health"
      ]
    },
    {
      "Sid": "NeverChangeApplicationBoundary",
      "Effect": "Deny",
      "Action": [
        "iam:PutRolePermissionsBoundary",
        "iam:DeleteRolePermissionsBoundary"
      ],
      "Resource": [
        "arn:aws:iam::${ACCOUNT_ID}:role/shelfstate-v4-dev-health"
      ]
    },
    {
      "Sid": "NeverEditBoundaryPolicy",
      "Effect": "Deny",
      "Action": [
        "iam:CreatePolicy",
        "iam:CreatePolicyVersion",
        "iam:SetDefaultPolicyVersion",
        "iam:DeletePolicyVersion",
        "iam:DeletePolicy"
      ],
      "Resource": [
        "arn:aws:iam::${ACCOUNT_ID}:policy/ShelfStateV4DevHealthBoundary"
      ]
    },
    {
      "Sid": "PassHealthToLambdaOnly",
      "Effect": "Allow",
      "Action": [
        "iam:PassRole"
      ],
      "Resource": [
        "arn:aws:iam::${ACCOUNT_ID}:role/shelfstate-v4-dev-health"
      ],
      "Condition": {
        "StringEquals": {
          "iam:PassedToService": "lambda.amazonaws.com"
        }
      }
    },
    {
      "Sid": "ReadSelectedZone",
      "Effect": "Allow",
      "Action": [
        "route53:GetHostedZone",
        "route53:ListResourceRecordSets"
      ],
      "Resource": [
        "arn:aws:route53:::hostedzone/${SELECTED_ZONE_ID}"
      ]
    },
    {
      "Sid": "PollDnsChange",
      "Effect": "Allow",
      "Action": [
        "route53:GetChange"
      ],
      "Resource": [
        "arn:aws:route53:::change/*"
      ]
    }
  ]
}
